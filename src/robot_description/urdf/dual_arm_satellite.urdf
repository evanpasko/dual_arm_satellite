<?xml version="1.0"?>
<robot name="dual_arm_satellite">
  <!-- Disk bus + two 4-DoF serial arms (cylinder links, zero arm link mass for massless-arm assumption). -->
  <!-- Root: world -> base_link (fixed identity) for RViz / robot_state_publisher. -->

  <link name="world"/>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.25" radius="0.35"/>
      </geometry>
      <material name="bus_material">
        <color rgba="0.2 0.45 0.75 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.25" radius="0.35"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="80.0"/>
      <!-- Thin uniform disk approximation: ixx/iyy = 0.25*m*r^2, izz = 0.5*m*r^2 -->
      <inertia ixx="2.45" ixy="0" ixz="0" iyy="2.45" iyz="0" izz="4.9"/>
    </inertial>
  </link>

  <joint name="world_to_base_link" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- ========== Left arm ========== -->
  <joint name="left_joint1" type="revolute">
    <parent link="base_link"/>
    <child link="left_link1"/>
    <origin xyz="0 0.35 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57079632679" upper="1.57079632679" effort="0" velocity="10"/>
  </joint>
  <link name="left_link1">
    <visual>
      <origin xyz="0.075 0 0" rpy="0 1.57079632679 0"/>
      <geometry>
        <cylinder length="0.15" radius="0.03"/>
      </geometry>
      <material name="left_link1_material">
        <color rgba="0.85 0.55 0.15 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0.075 0 0" rpy="0 1.57079632679 0"/>
      <geometry>
        <cylinder length="0.15" radius="0.03"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0"/>
      <inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/>
    </inertial>
  </link>

  <joint name="left_joint2" type="revolute">
    <parent link="left_link1"/>
    <child link="left_link2"/>
    <origin xyz="0.15 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-3.14" upper="3.14" effort="0" velocity="10"/>
  </joint>
  <link name="left_link2">
    <visual>
      <origin xyz="0.175 0 0" rpy="0 1.57079632679 0"/>
      <geometry>
        <cylinder length="0.35" radius="0.03"/>
      </geometry>
      <material name="left_link2_material">
        <color rgba="0.85 0.55 0.15 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0.175 0 0" rpy="0 1.57079632679 0"/>
      <geometry>
        <cylinder length="0.35" radius="0.03"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0"/>
      <inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/>
    </inertial>
  </link>

  <joint name="left_joint3" type="revolute">
    <parent link="left_link2"/>
    <child link="left_link3"/>
    <origin xyz="0.35 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-3.14" upper="3.14" effort="0" velocity="10"/>
  </joint>
  <link name="left_link3">
    <visual>
      <origin xyz="0.15 0 0" rpy="0 1.57079632679 0"/>
      <geometry>
        <cylinder length="0.30" radius="0.03"/>
      </geometry>
      <material name="left_link3_material">
        <color rgba="0.85 0.55 0.15 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0.15 0 0" rpy="0 1.57079632679 0"/>
      <geometry>
        <cylinder length="0.30" radius="0.03"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0"/>
      <inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/>
    </inertial>
  </link>

  <joint name="left_joint4" type="revolute">
    <parent link="left_link3"/>
    <child link="left_link4"/>
    <origin xyz="0.30 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14" upper="3.14" effort="0" velocity="10"/>
  </joint>
  <link name="left_link4">
    <visual>
      <origin xyz="0.06 0 0" rpy="0 1.57079632679 0"/>
      <geometry>
        <cylinder length="0.12" radius="0.03"/>
      </geometry>
      <material name="left_link4_material">
        <color rgba="0.85 0.55 0.15 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0.06 0 0" rpy="0 1.57079632679 0"/>
      <geometry>
        <cylinder length="0.12" radius="0.03"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0"/>
      <inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/>
    </inertial>
  </link>

  <link name="left_ee_thruster">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0"/>
      <inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/>
    </inertial>
  </link>
  <joint name="left_ee_fixed" type="fixed">
    <parent link="left_link4"/>
    <child link="left_ee_thruster"/>
    <origin xyz="0.12 0 0" rpy="0 0 0"/>
  </joint>

  <!-- ========== Right arm ========== -->
  <joint name="right_joint1" type="revolute">
    <parent link="base_link"/>
    <child link="right_link1"/>
    <origin xyz="0 -0.35 0" rpy="0 0 3.14159265359"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57079632679" upper="1.57079632679" effort="0" velocity="10"/>
  </joint>
  <link name="right_link1">
    <visual>
      <origin xyz="0.075 0 0" rpy="0 1.57079632679 0"/>
      <geometry>
        <cylinder length="0.15" radius="0.03"/>
      </geometry>
      <material name="right_link1_material">
        <color rgba="0.15 0.75 0.35 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0.075 0 0" rpy="0 1.57079632679 0"/>
      <geometry>
        <cylinder length="0.15" radius="0.03"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0"/>
      <inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/>
    </inertial>
  </link>

  <joint name="right_joint2" type="revolute">
    <parent link="right_link1"/>
    <child link="right_link2"/>
    <origin xyz="0.15 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-3.14" upper="3.14" effort="0" velocity="10"/>
  </joint>
  <link name="right_link2">
    <visual>
      <origin xyz="0.175 0 0" rpy="0 1.57079632679 0"/>
      <geometry>
        <cylinder length="0.35" radius="0.03"/>
      </geometry>
      <material name="right_link2_material">
        <color rgba="0.15 0.75 0.35 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0.175 0 0" rpy="0 1.57079632679 0"/>
      <geometry>
        <cylinder length="0.35" radius="0.03"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0"/>
      <inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/>
    </inertial>
  </link>

  <joint name="right_joint3" type="revolute">
    <parent link="right_link2"/>
    <child link="right_link3"/>
    <origin xyz="0.35 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-3.14" upper="3.14" effort="0" velocity="10"/>
  </joint>
  <link name="right_link3">
    <visual>
      <origin xyz="0.15 0 0" rpy="0 1.57079632679 0"/>
      <geometry>
        <cylinder length="0.30" radius="0.03"/>
      </geometry>
      <material name="right_link3_material">
        <color rgba="0.15 0.75 0.35 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0.15 0 0" rpy="0 1.57079632679 0"/>
      <geometry>
        <cylinder length="0.30" radius="0.03"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0"/>
      <inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/>
    </inertial>
  </link>

  <joint name="right_joint4" type="revolute">
    <parent link="right_link3"/>
    <child link="right_link4"/>
    <origin xyz="0.30 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14" upper="3.14" effort="0" velocity="10"/>
  </joint>
  <link name="right_link4">
    <visual>
      <origin xyz="0.06 0 0" rpy="0 1.57079632679 0"/>
      <geometry>
        <cylinder length="0.12" radius="0.03"/>
      </geometry>
      <material name="right_link4_material">
        <color rgba="0.15 0.75 0.35 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0.06 0 0" rpy="0 1.57079632679 0"/>
      <geometry>
        <cylinder length="0.12" radius="0.03"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0"/>
      <inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/>
    </inertial>
  </link>

  <link name="right_ee_thruster">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0"/>
      <inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/>
    </inertial>
  </link>
  <joint name="right_ee_fixed" type="fixed">
    <parent link="right_link4"/>
    <child link="right_ee_thruster"/>
    <origin xyz="0.12 0 0" rpy="0 0 0"/>
  </joint>
</robot>
